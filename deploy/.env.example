# Copy to ../.env on the server and fill in. Never commit the real file.

# --- Domains (no https://, no trailing slash) -------------------------------
SITE_DOMAIN=nexture.edu.np
API_DOMAIN=api.nexture.edu.np

# --- Ports on 127.0.0.1 (pick ones no other project on the server uses) -----
FRONTEND_PORT=3082
BACKEND_PORT=8082

# --- Django ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
# Leave at 0 until HTTPS works, then set to 31536000 and redeploy.
DJANGO_HSTS_SECONDS=0

# --- Database (private to this stack) --------------------------------------
DB_NAME=nexture
DB_USER=nexture
DB_PASSWORD=

# --- Media storage ---------------------------------------------------------
# False: uploads live on a docker volume and are served by the backend at /media/.
# True: Cloudflare R2. Create an R2 API token with "Object Read & Write" on the bucket,
# connect a custom domain to the bucket (R2_PUBLIC_DOMAIN), then fill these in.
USE_R2_STORAGE=True
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=media.nexture.edu.np

# --- Email (new inquiry notifications) -------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
LEAD_NOTIFICATION_EMAIL=
