# Base URL of the Django backend API, reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: server-side-only override, e.g. http://backend:8000/api inside
# docker-compose, so SSR fetches use the internal network instead of localhost.
API_URL_INTERNAL=

# Hostname media images are served from (R2 public domain in prod)
NEXT_PUBLIC_MEDIA_HOSTNAME=localhost
